    def _set_icon(self):
        for cand in (os.path.join(HERE, "assets", "neoforge.ico"),
                     os.path.join(BASE_DIR, "app", "assets", "neoforge.ico"),
                     os.path.join(getattr(sys, "_MEIPASS", ""), "assets", "neoforge.ico")):
